rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedInWithGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAdmin() {
      return signedInWithGoogle()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'ADMINISTRADOR'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    match /qr_codes/{merchantId}/{filePath=**} {
      allow read: if true;
      allow write: if signedInWithGoogle()
        && request.auth.uid == merchantId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp'];
    }

    match /releases/veripago-latest.apk {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType == 'application/vnd.android.package-archive';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
