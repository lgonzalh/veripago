rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInWithGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasRole(role) {
      return signedInWithGoogle()
        && userDoc(request.auth.uid).data.role == role
        && userDoc(request.auth.uid).data.isActive == true;
    }

    function isAdmin() { return hasRole('ADMINISTRADOR'); }
    function isMerchant(uid) { return hasRole('COMERCIANTE') && request.auth.uid == uid; }
    function validMerchantProduct(data) {
      return data.keys().hasOnly([
          'name', 'enteredPrice', 'vatRate', 'priceIncludesVat',
          'priceWithoutVat', 'vatAmount', 'priceWithVat'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.enteredPrice is int
        && data.enteredPrice > 0
        && data.vatRate is number
        && data.vatRate >= 0
        && data.vatRate <= 100
        && data.priceIncludesVat is bool
        && data.priceWithoutVat is int
        && data.priceWithoutVat > 0
        && data.vatAmount is int
        && data.vatAmount >= 0
        && data.priceWithVat is int
        && data.priceWithVat == data.priceWithoutVat + data.vatAmount
        && ((data.priceIncludesVat && data.enteredPrice == data.priceWithVat)
          || (!data.priceIncludesVat && data.enteredPrice == data.priceWithoutVat));
    }
    function validAdjustmentRule(rule) {
      return rule is map
        && rule.keys().hasOnly(['enabled', 'mode', 'value'])
        && rule.enabled is bool
        && rule.mode in ['FIXED', 'PERCENT']
        && rule.value is number
        && rule.value >= 0
        && ((rule.mode == 'FIXED' && rule.value <= 1000000000)
          || (rule.mode == 'PERCENT' && rule.value <= 100));
    }
    function validMerchantAdjustments(adjustments) {
      return adjustments is map
        && adjustments.keys().hasOnly(['perProduct', 'perOrder'])
        && validAdjustmentRule(adjustments.perProduct)
        && validAdjustmentRule(adjustments.perOrder);
    }
    function validMerchantFeeSettings(data) {
      return data.keys().hasOnly(['perProduct', 'perOrder', 'updatedAt'])
        && data.keys().hasAll(['perProduct', 'perOrder', 'updatedAt'])
        && data.updatedAt == request.time
        && validAdjustmentRule(data.perProduct)
        && validAdjustmentRule(data.perOrder);
    }
    function validMerchantQr(data, provider) {
      return provider in ['NEQUI', 'DAVIPLATA', 'BRE_B']
        && data.keys().hasOnly([
          'provider', 'contentType', 'imageBase64', 'paymentKeyLabel', 'beneficiaryName', 'updatedAt'
        ])
        && data.provider == provider
        && data.contentType == 'image/png'
        && data.imageBase64 is string
        && data.imageBase64.size() > 0
        && data.imageBase64.size() <= 750000
        && data.paymentKeyLabel is string
        && data.paymentKeyLabel.size() <= 100
        && data.beneficiaryName is string
        && data.beneficiaryName.size() <= 100
        && data.updatedAt == request.time;
    }
    function validMerchantQrLinkUpdate(uid) {
      return resource.data.defaultMode == 'IN_SITU_QR'
        && request.resource.data.defaultMode == 'IN_SITU_QR'
        && request.resource.data.paymentProvider in ['NEQUI', 'DAVIPLATA', 'BRE_B']
        && request.resource.data.qrImageUrl == 'veripagoqr://' + uid + '/' + request.resource.data.paymentProvider
        && validMerchantQr(
          getAfter(/databases/$(database)/documents/users/$(uid)/wallet_qrs/$(request.resource.data.paymentProvider)).data,
          request.resource.data.paymentProvider
        )
        && request.resource.data.paymentMethods is list
        && request.resource.data.paymentMethods.size() > 0
        && request.resource.data.paymentMethods.size() <= 3
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentMethods', 'paymentProvider', 'qrImageUrl', 'paymentKeyLabel', 'beneficiaryName', 'updatedAt'
        ]);
    }
    function validDeliveredItemProgress() {
      return resource.data.paymentStatus in ['VERIFIED_AUTO', 'VERIFIED_MANUAL']
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.deliveryStatus == resource.data.deliveryStatus
        && resource.data.items is list
        && request.resource.data.deliveredItemIndexes is list
        && request.resource.data.deliveredItemIndexes.size() == resource.data.get('deliveredItemIndexes', []).size() + 1
        && request.resource.data.deliveredItemIndexes.hasAll(resource.data.get('deliveredItemIndexes', []))
        && request.resource.data.deliveredItemIndexes.toSet().size() == request.resource.data.deliveredItemIndexes.size()
        && request.resource.data.deliveredItemIndexes.size() <= resource.data.items.size()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deliveredItemIndexes', 'localUpdatedAt', 'serverUpdatedAt'
        ]);
    }
    function validOrderDeliveryCompletion() {
      return resource.data.paymentStatus in ['VERIFIED_AUTO', 'VERIFIED_MANUAL']
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.deliveryStatus == 'DELIVERED'
        && resource.data.items is list
        && resource.data.items.size() > 0
        && resource.data.get('deliveredItemIndexes', []) is list
        && resource.data.get('deliveredItemIndexes', []).size() == resource.data.items.size()
        && resource.data.get('deliveredItemIndexes', []).toSet().size() == resource.data.items.size()
        && request.resource.data.get('deliveredItemIndexes', []) == resource.data.get('deliveredItemIndexes', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deliveryStatus', 'localUpdatedAt', 'serverUpdatedAt'
        ]);
    }
    match /users/{uid} {
      allow get: if signedInWithGoogle() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // A verified Google account may create its own merchant profile. Admin roles are assigned
      // only from the database by an existing administrator.
      allow create: if signedInWithGoogle()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoUrl', 'role', 'isActive',
          'quotaMaxLinks', 'loyaltyPoints', 'createdAt', 'lastLoginAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.photoUrl is string
        && request.resource.data.isActive == true
        && request.resource.data.quotaMaxLinks == 10
        && request.resource.data.loyaltyPoints == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time
        && request.resource.data.role == 'COMERCIANTE';
      allow update: if isAdmin()
        || (signedInWithGoogle() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoUrl', 'lastLoginAt']));
      allow delete: if isAdmin();

      match /settings/{settingId} {
        // Merchant contact details stay private to their own account.
        allow get: if signedInWithGoogle() && request.auth.uid == uid;
        allow list: if false;
        allow create, update: if (
          settingId == 'contact'
          && isMerchant(uid)
          && request.resource.data.keys().hasOnly(['whatsappNumber', 'updatedAt'])
          && request.resource.data.whatsappNumber is string
          && request.resource.data.whatsappNumber.size() <= 16
          && request.resource.data.updatedAt == request.time
        ) || (
          settingId == 'fees'
          && isMerchant(uid)
          && validMerchantFeeSettings(request.resource.data)
        );
        allow delete: if settingId == 'contact' && isMerchant(uid);
      }

      match /products/{productId} {
        // Catalogs are private: only the authenticated merchant who owns this user path can read or change them.
        allow get, list: if isMerchant(uid);
        allow create, update: if isMerchant(uid) && validMerchantProduct(request.resource.data);
        allow delete: if isMerchant(uid);
      }

      match /wallet_qrs/{provider} {
        allow get, list: if isMerchant(uid);
        allow create, update: if isMerchant(uid) && validMerchantQr(request.resource.data, provider);
        allow delete: if isMerchant(uid);
      }
    }

    match /public_merchant_qrs/{uid}/wallets/{provider} {
      // Customers use these images only after receiving a merchant's payment link or QR.
      allow get: if resource.data.provider == provider
        && resource.data.contentType == 'image/png'
        && resource.data.imageBase64 is string;
      allow list: if false;
      allow create, update: if isMerchant(uid) && validMerchantQr(request.resource.data, provider);
      allow delete: if isMerchant(uid);
    }

    match /payment_links/{linkId} {
      allow get, list: if (signedInWithGoogle()
        && (request.auth.uid == resource.data.merchantId || isAdmin()));
      // Creation and slug reservation run in a trusted transaction to enforce uniqueness.
      allow create: if false;
      allow update: if isMerchant(resource.data.merchantId)
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adjustments', 'updatedAt'])
            && request.resource.data.updatedAt == request.time
            && validMerchantAdjustments(request.resource.data.adjustments))
          || validMerchantQrLinkUpdate(resource.data.merchantId)
        );
      allow delete: if false;
    }

    match /public_payment_links/{slug} {
      // Public checkout uses a document key lookup. Listing the public catalog is denied.
      allow get: if resource.data.isActive == true;
      allow list: if false;
      allow update: if isMerchant(resource.data.merchantId)
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adjustments', 'updatedAt'])
            && request.resource.data.updatedAt == request.time
            && validMerchantAdjustments(request.resource.data.adjustments))
          || validMerchantQrLinkUpdate(resource.data.merchantId)
        );
      allow create, delete: if false;
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin()
        || (signedInWithGoogle() && (
          request.auth.uid == resource.data.merchantId
          || request.auth.uid == resource.data.customerUid
        ));
      allow create: if signedInWithGoogle()
        && isMerchant(request.resource.data.merchantId)
        && request.resource.data.paymentStatus == 'PENDING'
        && request.resource.data.deliveryStatus == 'PENDING_DELIVERY'
        && request.resource.data.totalAmount is number;
      allow update: if isAdmin()
        || (signedInWithGoogle() && isMerchant(resource.data.merchantId)
          && request.resource.data.merchantId == resource.data.merchantId
          && (validDeliveredItemProgress()
            || validOrderDeliveryCompletion()
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'senderAccountName', 'paymentStatus',
              'matchedNotificationId', 'localUpdatedAt', 'serverUpdatedAt'
            ])));
      allow delete: if isAdmin();
    }

    match /checkout_sessions/{sessionId} {
      // The random session ID is a bearer capability. Store only safe status fields here;
      // personal data and order items belong in the private orders collection.
      allow get: if resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /payment_notifications/{notifId} {
      allow get, list: if isAdmin()
        || (signedInWithGoogle() && request.auth.uid == resource.data.merchantId);
      allow create, update: if signedInWithGoogle()
        && isMerchant(request.resource.data.merchantId);
      allow delete: if isAdmin();
    }

    match /bank_parser_rules/{ruleId} {
      allow read: if signedInWithGoogle();
      allow write: if isAdmin();
    }

    match /linked_devices/{deviceId} {
      allow get, list: if isAdmin()
        || (signedInWithGoogle() && request.auth.uid == resource.data.merchantId);
      allow create, update: if signedInWithGoogle()
        && request.resource.data.merchantId == request.auth.uid
        && isMerchant(request.auth.uid);
      allow delete: if isAdmin()
        || (signedInWithGoogle() && request.auth.uid == resource.data.merchantId);
    }

    match /platform_settings/{settingId} {
      allow get: if settingId == 'global' || signedInWithGoogle();
      allow list: if signedInWithGoogle();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if resource.data.isPublished == true || signedInWithGoogle();
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // Immutable from clients, including administrators. Trusted server code may append.
      allow write: if false;
    }
  }
}
