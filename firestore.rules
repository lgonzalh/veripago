rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInWithGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasRole(role) {
      return signedInWithGoogle()
        && userDoc(request.auth.uid).data.role == role
        && userDoc(request.auth.uid).data.isActive == true;
    }

    function isAdmin() { return hasRole('ADMINISTRADOR'); }
    function isMerchant(uid) { return hasRole('COMERCIANTE') && request.auth.uid == uid; }
    match /users/{uid} {
      allow get: if signedInWithGoogle() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // A verified Google account may create its own profile. The admin role is limited to the
      // explicit bootstrap email; all other first-time users become merchants.
      allow create: if signedInWithGoogle()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoUrl', 'role', 'isActive',
          'quotaMaxLinks', 'loyaltyPoints', 'createdAt', 'lastLoginAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.photoUrl is string
        && request.resource.data.isActive == true
        && request.resource.data.quotaMaxLinks == 10
        && request.resource.data.loyaltyPoints == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time
        && ((request.auth.token.email == 'lantonium@gmail.com'
              && request.resource.data.role == 'ADMINISTRADOR')
          || (request.auth.token.email != 'lantonium@gmail.com'
              && request.resource.data.role == 'COMERCIANTE'));
      allow update: if isAdmin()
        || (signedInWithGoogle() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoUrl', 'lastLoginAt']))
        || (signedInWithGoogle() && request.auth.uid == uid
          && request.auth.token.email == 'lantonium@gmail.com'
          && request.resource.data.role == 'ADMINISTRADOR'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['role', 'lastLoginAt']));
      allow delete: if isAdmin();
    }

    match /payment_links/{linkId} {
      allow get, list: if (signedInWithGoogle()
        && (request.auth.uid == resource.data.merchantId || isAdmin()));
      // Creation and slug reservation run in a trusted transaction to enforce uniqueness.
      allow create: if false;
      allow update, delete: if false;
    }

    match /public_payment_links/{slug} {
      // Public checkout uses a document key lookup. Listing the public catalog is denied.
      allow get: if resource.data.isActive == true;
      allow list: if false;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin()
        || (signedInWithGoogle() && (
          request.auth.uid == resource.data.merchantId
          || request.auth.uid == resource.data.customerUid
        ));
      allow create: if signedInWithGoogle()
        && isMerchant(request.resource.data.merchantId)
        && request.resource.data.paymentStatus == 'PENDING'
        && request.resource.data.deliveryStatus == 'PENDING_DELIVERY'
        && request.resource.data.totalAmount is number;
      allow update: if isAdmin()
        || (signedInWithGoogle() && isMerchant(resource.data.merchantId)
          && request.resource.data.merchantId == resource.data.merchantId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'senderAccountName', 'paymentStatus', 'deliveryStatus',
            'matchedNotificationId', 'localUpdatedAt', 'serverUpdatedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /checkout_sessions/{sessionId} {
      // The random session ID is a bearer capability. Store only safe status fields here;
      // personal data and order items belong in the private orders collection.
      allow get: if resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /payment_notifications/{notifId} {
      allow get, list: if isAdmin()
        || (signedInWithGoogle() && request.auth.uid == resource.data.merchantId);
      allow create, update: if signedInWithGoogle()
        && isMerchant(request.resource.data.merchantId);
      allow delete: if isAdmin();
    }

    match /bank_parser_rules/{ruleId} {
      allow read: if signedInWithGoogle();
      allow write: if isAdmin();
    }

    match /linked_devices/{deviceId} {
      allow get, list: if isAdmin()
        || (signedInWithGoogle() && request.auth.uid == resource.data.merchantId);
      allow create, update: if signedInWithGoogle()
        && request.resource.data.merchantId == request.auth.uid
        && isMerchant(request.auth.uid);
      allow delete: if isAdmin()
        || (signedInWithGoogle() && request.auth.uid == resource.data.merchantId);
    }

    match /platform_settings/{settingId} {
      allow get: if settingId == 'global' || signedInWithGoogle();
      allow list: if signedInWithGoogle();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if resource.data.isPublished == true || signedInWithGoogle();
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // Immutable from clients, including administrators. Trusted server code may append.
      allow write: if false;
    }
  }
}
